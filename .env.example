# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repo (está en .gitignore).
# Si tu parte necesita una variable nueva, agrégala en su sección, en el mismo PR.

# --- Compartido ---
# Conexión a PostgreSQL. Se completa cuando exista el docker-compose.
DATABASE_URL=

# --- Ingesta ---
# Token de GitHub. Sin token, GitHub permite 60 peticiones por hora.
GITHUB_TOKEN=

# --- IA ---
# Clave del proveedor de LLM. Se completa cuando se elija el modelo.
LLM_API_KEY=

# --- Ingesta: sincronización incremental del catálogo ---
# Destino por defecto: local | supabase.
OPENBRIDGE_SYNC_TARGET=supabase
# Escrituras: solo `1` las habilita (ausente o 0 = solo lectura).
OPENBRIDGE_SYNC_ALLOW_WRITES=0
# Confirmación exacta que exige --apply.
OPENBRIDGE_SYNC_CONFIRMATION=
# Cuenta de servicio de Supabase (nunca postgres ni postgres.*).
OPENBRIDGE_SUPABASE_DB_HOST=
OPENBRIDGE_SUPABASE_DB_PORT=5432
OPENBRIDGE_SUPABASE_DB_NAME=postgres
OPENBRIDGE_SUPABASE_DB_USER=
OPENBRIDGE_SUPABASE_DB_PASSWORD=
OPENBRIDGE_SUPABASE_DB_SSLMODE=require
# PostgreSQL local (docker-compose).
OPENBRIDGE_LOCAL_DB_HOST=localhost
OPENBRIDGE_LOCAL_DB_PORT=5432
OPENBRIDGE_LOCAL_DB_NAME=openbridge_db
OPENBRIDGE_LOCAL_DB_USER=
OPENBRIDGE_LOCAL_DB_PASSWORD=
OPENBRIDGE_LOCAL_DB_SSLMODE=prefer
# Pipeline histórico insert-only (ingestion/src/config.py). Lee SUPABASE_DB_* y,
# por compatibilidad, DB_*.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

