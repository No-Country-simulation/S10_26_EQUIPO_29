# Ejecutar desde la raíz del repositorio. No guardar credenciales en Git.
# Rol de SOLO LECTURA: usuario largo del pooler, openbridge_ai_reader.<project_ref>.
# Estado de permisos y pendientes: backend/docs/acceso-base-datos.md
# Formato: postgresql+psycopg://USUARIO:PASSWORD@HOST:PUERTO/BASEDATOS?sslmode=require
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# health_score (índice por reglas v1): sólo se publica si el equipo aprueba la
# fórmula y los pesos. Apagado, la API mantiene health_score en null.
HEALTH_SCORE_ENABLED=false
# Paginación del catálogo: por defecto y máximo permitido por petición.
CATALOG_PAGE_SIZE=20
CATALOG_MAX_PAGE_SIZE=100
# Límites de la conexión a base de datos (segundos y milisegundos).
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=8000
